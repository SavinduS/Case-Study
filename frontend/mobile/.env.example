# Copy this file to `.env` (same folder) and set your computer's LAN IP:
#   Windows: run `ipconfig` → "IPv4 Address" under your active adapter
#   Android emulator: http://10.0.2.2:5000
#
# EXPO_PUBLIC_ vars are inlined when the JS bundle is built — restart
# Expo with `npx expo start -c` after changing this file.
#
# Check it works: open http://<your-ip>:5000/health on the phone's browser.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5000
