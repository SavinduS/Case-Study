# Copy to .env in this folder and fill in your machine's address.
# Expo loads this file automatically; EXPO_PUBLIC_* values reach the app.
# Only needed when the app cannot find the backend on its own.

# API (npm run backend). Match PORT in backend/.env — 5055 in this repo's
# local setup. Use the LAN IP so a real phone can reach this machine.
EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:5055

# Operations Dashboard (npm run web), used for the Manager/Officer sign-in
# handoff. Same host, port 5173.
EXPO_PUBLIC_WEB_UI_URL=http://192.168.x.x:5173