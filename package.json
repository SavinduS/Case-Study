{
  "name": "wildlife-conservation",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend/*"
  ],
  "scripts": {
    "dev": "npm run backend & npm run web & wait",
    "backend": "npm run dev -w backend",
    "web": "npm run dev -w frontend/web",
    "mobile": "npm run start -w frontend/mobile",
    "seed": "npm run seed -w backend",
    "seed:reset": "npm run seed:reset -w backend",
    "test": "npm run test -w backend",
    "test:web": "npm run test -w frontend/web",
    "test:mobile": "npm run test -w frontend/mobile",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "typescript-eslint": "^8.71.2"
  }
}
