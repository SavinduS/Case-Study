{
  "name": "backend",
  "version": "0.1.0",
  "scripts": {
    "dev": "node server.js",
    "seed": "node seed/seedReferenceData.js",
    "seed:reset": "node seed/resetOperationalData.js",
    "test": "npm run test:jest && npm run test:vitest",
    "test:jest": "jest --runInBand",
    "test:vitest": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/tests/*.test.js"]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "vitest": "^2.1.8"
  }
}
